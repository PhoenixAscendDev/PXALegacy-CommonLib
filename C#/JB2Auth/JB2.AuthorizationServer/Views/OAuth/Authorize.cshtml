@using System.Security.Claims
@using System.Web
@{
    var authentication = Context.GetOwinContext().Authentication;
    var ticket = authentication.AuthenticateAsync("Application").Result;
    var identity = ticket != null ? ticket.Identity : null;
    var scopes = (Request.QueryString.Get("scope") ?? "").Split(' ');
    Layout = "~/Views/Shared/_popupLayout.cshtml";
}

<div id="login-form">
    <div class="section-out">
        <section class="login-section">
            <div class="login">

                <form method="POST">
                    <h2>Hello, @identity.Name</h2>
                    <h3>A third party application want to do the following on your behalf:</h3>
                    <ul>
                        @foreach (var scope in scopes)
                        {
                            <li>@scope</li>
                        }
                    </ul>
                    <p>
                        <div class="row">
                            <div class="col-xs-6">
                                <input type="submit" name="submit.Grant" value="Grant" class="btn" />
                            </div>
                            <div class="col-xs-6">
                                <input type="submit" name="submit.LogOut" value="Sign Out" class="btn" />
                                
                                
                                    
</div>
                        </div>
                    </p>
                </form>
            </div>

            <div class="social-login"></div>
        </section>
    </div>
</div>
